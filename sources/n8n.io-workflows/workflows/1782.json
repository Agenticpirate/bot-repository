          [
            {
              "node": "If lead is Ideal Buyer",
              "type": "main",
              "index": 0
            },
            {
              "node": "Merge",
              "type": "main",
              "index": 1
            }
          ]
        ]
      },
      "Datagma - Find Emails": {
        "main": [
          [
            {
              "node": "Prepare Data Before Merge",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "If lead is Ideal Buyer": {
        "main": [
          [
            {
              "node": "Datagma - Find Emails",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Datagma - Enrich Company": {
        "main": [
          [
            {
