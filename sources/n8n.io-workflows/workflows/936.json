          "lastname": "Ryan",
          "firstname": "Jack",
          "additionalFields": {}
        },
        "credentials": {
          "tapfiliateApi": {
            "id": "credential-id",
            "name": "tapfiliateApi Credential"
          }
        },
        "typeVersion": 1
