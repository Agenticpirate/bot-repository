              "type": "main",
              "index": 1
            }
          ]
        ]
      },
      "Spreadsheet File1": {
        "main": [
          [
            {
              "node": "NextCloud1",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
