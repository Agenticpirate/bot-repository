        ],
        "parameters": {
          "notes": "✅ After setup, create a sample ticket in Zendesk to test:\n- Does AI reply appear?\n- Correct tags (`ai_reply` / `human_requested`)?\n- Memory stored in Postgres?\nIf yes → workflow is ready!"
        },
        "typeVersion": 1
