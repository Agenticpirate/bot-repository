        ],
        "parameters": {
          "jsCode": "\nconsole.log($('Error Trigger').last().json.execution)\nstr = escape ($('Error Trigger').last().json.execution.error.stack )\nreturn { \"stack\": str}"
        },
        "notesInFlow": true,
        "typeVersion": 2
      },
