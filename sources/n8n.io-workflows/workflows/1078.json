          "resource": "message",
          "operation": "getAll",
          "additionalFields": {
            "format": "resolved",
            "labelIds": [
              "Label_1819449526183990002"
            ]
          }
        },
        "credentials": {
          "gmailOAuth2": "Gmail"
        },
        "typeVersion": 1
      },
      {
        "name": "Upload File1",
