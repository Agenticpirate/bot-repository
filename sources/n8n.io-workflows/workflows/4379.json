        "name": "LLM Message Format",
        "type": "@n8n/n8n-nodes-langchain.chainLlm",
        "position": [
          1080,
          1100
        ],
        "parameters": {
          "text": "={{ $json.text }} List all affected sites and add a short funny wish for the IT team.",
