                  "operation": "equals"
                },
                "leftValue": "={{ $json.DOB.split('/').slice(0,2).join('-')}}\n",
                "rightValue": "={{ $now.toFormat(\"dd-MM\") }}"
              }
            ]
          }
        },
        "typeVersion": 2.2
      },
      {
