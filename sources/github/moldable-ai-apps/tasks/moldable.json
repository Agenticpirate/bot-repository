  "appApi": {
    "version": 1,
    "capabilities": [
      {
        "id": "tasks.projects",
        "name": "Projects",
        "description": "Read and manage local task projects in the active workspace.",
        "scopes": [
          {
            "id": "tasks.native.read",
            "risk": "low",
            "surfaces": [
              "voice",
              "nativeUI"
            ],
            "name": "Read the mobile Tasks experience",
            "description": "Return a bounded NativeUI projection for a project directory, one project, one task, or task search results.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "route": {
                  "type": "string",
                  "enum": [
                    "projects",
                    "project",
                    "task",
                    "search"
                  ]
                },
                "projectId": {
                  "type": "string"
                },
                "taskId": {
                  "type": "string"
                },
                "query": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "route"
              ],
              "additionalProperties": false
            }
          },
          {
            "id": "tasks.native.update",
            "risk": "important",
            "surfaces": [
              "nativeUI"
            ],
            "name": "Update a task from NativeUI",
            "description": "Update one task and resolve bounded server-projected label choices.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "taskId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "acceptanceCriteria": {
                  "type": "string"
                },
                "priority": {
                  "type": "string",
                  "enum": [
                    "none",
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "statusChoice": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "backlog",
                      "open",
                      "in_progress",
                      "completed",
                      "closed"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 1
                },
                "labelChoices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "label-1",
                      "label-2",
                      "label-3",
                      "label-4",
                      "label-5",
                      "label-6"
                    ]
                  },
                  "maxItems": 6
                }
              },
              "required": [
                "taskId",
                "title",
                "description",
                "acceptanceCriteria",
                "priority",
                "statusChoice",
                "labelChoices"
              ],
              "additionalProperties": false
            }
          },
