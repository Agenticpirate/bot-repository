          {
            "id": "redecorate.native.read",
            "name": "Read the mobile Redecorate experience",
            "description": "Return one route-specific, bounded NativeUI projection for the space gallery, one design collection, or one design and its verified image variants.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "route": {
                  "type": "string",
                  "enum": [
                    "home",
                    "collection",
                    "design"
                  ]
                },
                "view": {
                  "type": "string",
                  "enum": [
                    "all",
                    "favorites",
                    "folder"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "limit": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 16
                }
              },
              "required": [
                "route"
              ],
              "additionalProperties": false
            },
            "risk": "low",
            "surfaces": [
              "voice",
              "nativeUI"
            ]
          },
          {
            "id": "redecorate.native.mutate",
            "name": "Update one mobile design preference",
            "description": "Set the favorite state for one design and return only a bounded mutation receipt.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "favorite"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "favorite": {
                  "type": "boolean"
                }
              },
              "required": [
                "action",
                "id",
                "favorite"
              ],
              "additionalProperties": false
            },
            "risk": "low",
            "surfaces": [
              "voice",
              "nativeUI"
            ],
            "changesState": true
          },
