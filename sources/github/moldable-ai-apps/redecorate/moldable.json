  "license": "MIT",
  "icon": "🛋️",
  "iconPath": "public/icon.png",
  "category": "graphics-design",
  "tags": [
    "interior design",
    "home",
    "redesign",
    "renovation",
    "architecture",
    "landscape",
    "staging",
    "gpt-image-2"
  ],
  "moldableDependencies": {
    "@moldable-ai/editor": "^0.1.57",
    "@moldable-ai/ui": "^0.2.59",
    "@moldable-ai/storage": "^0.1.8"
  },
  "appApi": {
