{
  "mobile": {
    "type": "mobile-web",
    "path": "dist-mobile"
  },
  "name": "Redecorate",
  "version": "0.1.14",
  "aliases": [
    "interior design",
    "home design",
    "room makeover",
    "redesign",
    "renovation",
    "landscape design"
  ],
  "runtime": "vite_hono",
  "window": {
    "titlebar": "app",
    "nativeMaterial": {
      "background": true
    }
  },
  "visibility": "public",
  "description": "Reimagine your home, inside and out — a folder-based playground for AI room, exterior, backyard, and floorplan redesigns.",
