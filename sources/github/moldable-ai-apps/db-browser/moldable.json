            "risk": "important",
            "surfaces": [
              "voice"
            ],
            "name": "Update dashboard chart",
            "description": "Update a chart by dashboardId/dashboardName and chartId/chartName. Preserve existing chart fields unless the user asks to change them.",
            "inputSchema": {
