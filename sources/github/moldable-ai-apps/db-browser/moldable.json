      {
        "id": "db-browser.drive",
        "name": "Drive Database",
        "description": "Inspect and visibly navigate database connections, table previews, SQL workspaces, and dashboards.",
        "scopes": [
          {
            "id": "db-browser.ui.describe",
            "risk": "low",
            "surfaces": [
              "voice"
            ],
            "name": "Describe Database UI",
            "description": "List every navigable Database view with model-readable table, SQL tab, and dashboard entity guidance.",
            "inputSchema": {
              "type": "object",
              "properties": {}
            }
          },
          {
            "id": "db-browser.ui.navigate",
            "risk": "low",
            "surfaces": [
              "voice"
            ],
            "name": "Navigate Database UI",
            "description": "Navigate the visible Database app to connections, table, query, or dashboard. Table entityId is schema.table and is validated against the active connection; SQL tab and dashboard ids are also validated.",
            "inputSchema": {
              "type": "object",
              "required": [
                "view"
              ],
              "properties": {
                "view": {
                  "type": "string",
                  "enum": [
                    "connections",
                    "table",
                    "query",
                    "dashboard"
                  ]
                },
                "entityId": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "description": "Optional connectionId and view-specific parameters."
                }
              }
            }
          },
          {
            "id": "db-browser.ui.openTable",
            "risk": "low",
            "surfaces": [
              "voice"
            ],
            "name": "Open database table",
            "description": "Open an existing table or view in the bounded row-preview UI. table should be schema.table; an unqualified name is accepted only when unique in the active connection. This changes only the visible UI.",
            "inputSchema": {
              "type": "object",
              "required": [
                "table"
              ],
              "properties": {
                "table": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "db-browser.query.run",
            "risk": "low",
            "surfaces": [
              "voice"
            ],
            "name": "Run read-only query",
            "description": "Run one bounded read-only SQL statement using Database's existing db-browser.query.runReadonly execution path. Use only when the user explicitly asks to execute a query; writes and admin statements are rejected by the existing read-only policy.",
            "inputSchema": {
              "type": "object",
              "required": [
                "sql"
              ],
              "properties": {
                "connectionId": {
                  "type": "string"
                },
                "sql": {
                  "type": "string"
                }
              }
            }
          },
          {
            "id": "db-browser.ui.read",
            "risk": "low",
            "surfaces": [
              "voice"
            ],
            "name": "Read Database view",
            "description": "Read a faithful structured representation of the target view. Table reads return columns and at most 200 rows; query reads return saved SQL tabs plus the most recent drive-query rows; connection and dashboard views return their owned structured data.",
            "inputSchema": {
              "type": "object",
              "properties": {
                "view": {
                  "type": "string",
                  "enum": [
                    "connections",
                    "table",
                    "query",
                    "dashboard"
                  ]
                },
                "entityId": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      {
        "id": "db-browser.cards",
        "name": "Chat cards",
        "description": "Compact read-only preview with fuller quick look.",
        "scopes": [
