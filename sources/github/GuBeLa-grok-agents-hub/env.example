# ============================================
# Grok Agents Hub - Environment Configuration
# ============================================
# 
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!
#
# Command: cp env.example .env
# ============================================

# ============================================
# REQUIRED: Grok API Configuration
# ============================================
# Get your API key from: https://x.ai/api
# This is REQUIRED for the CLI and agents to work
GROK_API_KEY=your_grok_api_key_here

# ============================================
# OPTIONAL: API Endpoint Configuration
# ============================================
# Default: https://api.x.ai/v1
# Usually you don't need to change this
GROK_API_ENDPOINT=https://api.x.ai/v1

# ============================================
# OPTIONAL: Request Timeout
# ============================================
# Timeout in milliseconds (default: 30000 = 30 seconds)
GROK_API_TIMEOUT=30000

# ============================================
# OPTIONAL: Analytics
# ============================================
# Enable/disable usage analytics (default: true)
ENABLE_ANALYTICS=true

# ============================================
# OPTIONAL: Cache Configuration
# ============================================
# Directory where agents are installed (default: ~/.grok-agents)
CACHE_DIR=~/.grok-agents

# ============================================
# SECURITY NOTES:
# ============================================
# 1. NEVER commit .env file to Git
# 2. Keep your API keys secret
# 3. Rotate keys if compromised
# 4. Use different keys for dev/prod
# ============================================

