{
  "name": "x-api-connector",
  "version": "1.0.0",
  "description": "Integration with X (Twitter) API for Grok",
  "type": "api",
  "endpoint": "https://api.x.ai/v1",
  "auth": {
    "type": "api_key",
    "header": "Authorization",
    "format": "Bearer {api_key}"
  },
  "config": {
    "base_url": "https://api.x.ai/v1",
    "timeout": 30000,
    "retry_attempts": 3
  },
  "capabilities": [
    "chat_completions",
    "streaming",
    "function_calling"
  ],
  "tags": ["api", "grok", "x-ai"],
  "usage": "Configure with GROK_API_KEY to connect to Grok API"
}

