{
  "name": "notion",
  "version": "1.0.0",
  "description": "Integration with Notion for note synchronization",
  "type": "oauth",
  "endpoint": "https://api.notion.com/v1",
  "auth": {
    "type": "oauth2",
    "header": "Authorization",
    "format": "Bearer {token}"
  },
  "config": {
    "api_version": "2022-06-28",
    "base_url": "https://api.notion.com/v1"
  },
  "capabilities": [
    "create_pages",
    "update_pages",
    "read_pages",
    "sync_content",
    "search_notes"
  ],
  "tags": ["notion", "notes", "productivity", "sync"],
  "usage": "OAuth setup required. Automatically syncs Grok-generated content to Notion pages."
}

