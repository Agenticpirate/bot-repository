{
  "name": "slack",
  "version": "1.0.0",
  "description": "Integration with Slack for team communication",
  "type": "oauth",
  "endpoint": "https://slack.com/api",
  "auth": {
    "type": "oauth2",
    "scopes": [
      "channels:read",
      "chat:write",
      "users:read"
    ]
  },
  "config": {
    "api_url": "https://slack.com/api",
    "webhook_url": "{{webhook_url}}"
  },
  "capabilities": [
    "send_messages",
    "read_channels",
    "summarize_conversations",
    "notify_team"
  ],
  "tags": ["slack", "communication", "team"],
  "usage": "Configure Slack app and webhook for team notifications and summaries"
}

