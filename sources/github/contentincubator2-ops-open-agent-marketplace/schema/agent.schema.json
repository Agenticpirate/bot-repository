{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent",
  "type": "object",
  "required": [
    "slug",
    "name",
    "title",
    "layer",
    "category",
    "primarySkill",
    "summary",
    "exampleTasks"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "layer": {
      "enum": [
        "strategy",
        "execution",
        "training"
      ]
    },
    "category": {
      "type": "string"
    },
    "primarySkill": {
      "type": "string"
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "exampleTasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pricingTier": {
      "enum": [
        "free",
        "starter",
        "team",
        "business",
        "enterprise"
      ]
    },
    "source": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "channelExpertise": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "funnelStage": {
      "type": "array",
      "items": {
        "enum": [
          "awareness",
          "consideration",
          "conversion",
          "retention",
          "referral"
        ]
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qualityRubrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskFlags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
