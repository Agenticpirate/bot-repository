{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Squad",
  "type": "object",
  "required": [
    "slug",
    "name",
    "summary",
    "useCase",
    "agents",
    "workflow"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "useCase": {
      "type": "string"
    },
    "recommendedFor": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}